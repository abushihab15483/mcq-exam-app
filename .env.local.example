# এই ফাইলের নাম .env.local করে আসল value বসাও
# Supabase Dashboard > Settings > API থেকে এই তিনটা পাবে

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# SEO — Vercel এ ডিপ্লয় করার পর তোমার আসল ডোমেইন এখানে বসাও (শেষে / দিও না)।
# এইটা sitemap.xml, robots.txt, canonical URL, আর OpenGraph শেয়ার লিংকে ব্যবহার হয়।
# উদাহরণ: https://ankurjamalpur.com অথবা https://mcq-exam-app-xxxx.vercel.app
NEXT_PUBLIC_SITE_URL=
